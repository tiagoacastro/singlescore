# ------------------------------------------------------------------------
# SingleScore environment template. Copy to .env and fill in real values.
# .env is gitignored. Never commit real secrets.
# ------------------------------------------------------------------------

# SingleStoreDB (dedicated workspace) — used by the Go backend at runtime.
SINGLESTORE_HOST=svc-xxxx-dml.aws-oregon-4.svc.singlestore.com
SINGLESTORE_PORT=3306
SINGLESTORE_USER=admin
SINGLESTORE_PASSWORD='change-me'
SINGLESTORE_DATABASE=singlescore

# Backend server
BACKEND_HTTP_ADDR=:8080
BACKEND_LOG_LEVEL=info
BACKEND_DEMO_MODE=true           # when true, backend serves seeded demo data
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend (webpack dev server)
FRONTEND_PORT=3000
FRONTEND_GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# ------------------------------------------------------------------------
# Live ingestion — football-data.org (free tier).
# Register at https://www.football-data.org/client/register to get a token.
# The free tier covers the five leagues we support (PPL, PL, SA, PD, BL1)
# and allows 10 requests/minute per token.
# This token MUST live only on the backend. It is never exposed to the
# React app. Leave empty to disable live ingestion; the backend will fall
# back to seeded demo data.
# ------------------------------------------------------------------------
FOOTBALL_DATA_API_TOKEN=
