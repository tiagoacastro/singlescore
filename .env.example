# ------------------------------------------------------------------------
# SingleScore environment template. Copy to .env and fill in real values.
# .env is gitignored. Never commit real secrets.
# ------------------------------------------------------------------------

# SingleStoreDB (dedicated workspace) — used by the Go backend at runtime.
SINGLESTORE_HOST=svc-xxxx-dml.aws-oregon-4.svc.singlestore.com
SINGLESTORE_PORT=3306
SINGLESTORE_USER=admin
SINGLESTORE_PASSWORD='change-me'
SINGLESTORE_DATABASE=singlescore

# Backend server
BACKEND_HTTP_ADDR=:8080
BACKEND_LOG_LEVEL=info
BACKEND_DEMO_MODE=true           # shows the DEMO badge and serves the GraphQL Playground
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend (webpack dev server)
FRONTEND_PORT=3000
FRONTEND_GRAPHQL_ENDPOINT=http://localhost:8080/graphql
