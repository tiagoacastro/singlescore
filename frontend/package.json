{
  "name": "singlescore-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SingleScore React frontend (Webpack + SWC + Apollo + Recharts).",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test": "npm run test:e2e"
  },
  "dependencies": {
    "@apollo/client": "^3.11.8",
    "graphql": "^16.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.7.26",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "sass": "^1.80.5",
    "sass-loader": "^16.0.2",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
